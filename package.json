{
  "name": "@absolit/lint-config",
  "version": "1.0.0",
  "description": "Shared ESLint and Prettier presets per stack (Nuxt, Laravel + Vue, React, Next.js).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    "./eslint/nuxt": "./eslint/nuxt.js",
    "./eslint/laravel-vue": "./eslint/laravel-vue.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/rules": "./eslint/rules.js",
    "./prettier": "./prettier/base.js",
    "./prettier/nuxt": "./prettier/nuxt.js",
    "./prettier/laravel": "./prettier/laravel.js",
    "./prettier/react": "./prettier/react.js",
    "./prettier/next": "./prettier/next.js",
    "./package.json": "./package.json"
  },
  "files": [
    "eslint",
    "prettier",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "eslint-config-next": ">=16.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
